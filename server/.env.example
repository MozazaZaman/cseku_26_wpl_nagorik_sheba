# Nagorik Sheba — server configuration template.
# Copy to server/.env and fill in real values. NEVER commit a filled .env.
# .env is git-ignored (see .gitignore).

# --- App ---
PORT=5000

# --- Database ---
# Local dev: leave empty to use SQLite (server/data/nagorik.db).
# Production (Neon): paste the pooled connection string.
# Example: postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/nagorik?sslmode=require
DATABASE_URL=

# --- CORS ---
# Comma-separated list of allowed web origins in production.
# Example: https://nagorik-sheba.netlify.app
FRONTEND_URL=http://localhost:3000

# --- Uploads (Cloudinary) ---
# Local dev: leave empty to store files in server/uploads/.
# Production: fill all three to upload to Cloudinary (survives restarts).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=nagorik-sheba

# --- Auth ---
# Required in production. If unset, the server falls back to a hardcoded
# development secret (do NOT rely on the fallback outside local dev).
JWT_SECRET=

# --- AI assistant (existing) ---
GEMINI_API_KEY=

# --- Billing / payments (SSLCommerz) ---
# Provider name (only 'sslcommerz' is implemented; others are future adapters).
BILL_GATEWAY_PROVIDER=sslcommerz
# true = sandbox endpoints, false = live endpoints.
BILL_SSLCZ_SANDBOX=true
# Merchant credentials — sandbox or live depending on BILL_SSLCZ_SANDBOX.
# Obtain from https://www.sslcommerz.com/ (merchant onboarding).
BILL_SSLCZ_STORE_ID=
BILL_SSLCZ_STORE_PASSWD=
# ISO currency code for invoices/payments.
BILL_CURRENCY=BDT
# Public web URL used to build gateway success/fail/cancel return links.
BILL_PUBLIC_WEB_URL=http://localhost:3000

# --- Super admin bootstrap (used by: npm run seed:admin) ---
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
