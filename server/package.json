{
  "name": "nagorik-sheba-server",
  "version": "1.0.0",
  "description": "Agentic municipal complaint management platform - REST API",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "dev:fresh": "node scripts/free-port.mjs 5000 && node --watch src/index.js",
    "start": "node src/index.js",
    "seed": "node src/seed.js",
    "seed:reviews": "node scripts/seed-reviews.mjs",
    "seed:leaderboard": "node scripts/seed-leaderboard.mjs",
    "seed:badges": "node scripts/seed-badges.mjs",
    "seed:badges:reset": "node scripts/seed-badges.mjs --reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:admin": "node scripts/seed-admin.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@napi-rs/canvas": "^1.0.8",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^18.0.0",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "sinon": "^18.0.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
